# Copie para .env.local para desenvolvimento local.
#
# SHOW_ALL_VERSIONS controla a visibilidade das abas V2 (Garagem) e V3 (Sobrado).
#   true                      → mostra V1, V2 e V3
#   ausente / null / outro    → mostra só a V1 (padrão seguro de produção)
#
# Local: o .env.local deste projeto já vem com true.
# Vercel: adicione SHOW_ALL_VERSIONS=true em Project Settings → Environment Variables
#         quando quiser liberar V2/V3 publicamente, e faça um redeploy.
SHOW_ALL_VERSIONS=true
